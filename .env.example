# Base URL of your Home Assistant instance (no trailing slash).
HA_URL=http://localhost:8123

# Long-lived access token: HA UI -> Profile -> Security -> Long-lived access tokens.
# Never commit the real value.
HA_TOKEN=replace-me

# Optional
# HA_TIMEOUT_SECONDS=10
# HA_CACHE_TTL_SECONDS=10
# LOG_LEVEL=INFO
